# Community Lens — configuración local. Copiá a .env (no se versiona).

# Servidor (loopback por defecto; no lo cambiés salvo que sepás por qué)
CL_HOST=127.0.0.1
CL_PORT=8765
# Ruta de la base SQLite
CL_DB_PATH=data/community_lens.db
# Zona horaria inicial sugerida al importar (editable por chat en la UI)
CL_DEFAULT_TZ=America/Costa_Rica

# --- JEV (TypeSafe) — OPCIONAL ---
# Sin estas variables la app funciona completa con el proveedor de reglas.
# Activar JEV envía texto de mensajes a api.typesafe.ai. Requiere además
# confirmación explícita en la UI por cada ejecución.
JEV_ENABLED=0
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Umbral sobre el valor "noul" (0–1) para asignar una categoría
JEV_THRESHOLD=0.8
# Mensajes previos enviados como contexto (0 = ninguno)
JEV_CONTEXT_MESSAGES=2
# Tope de mensajes por ejecución (control de costo y exposición)
JEV_MAX_MESSAGES=200
