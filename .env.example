# Community Lens — configuración local. Copiar a .env 

# Servidor (loopback por defecto; no lo cambiés salvo que sepás por qué)
CL_HOST=127.0.0.1
CL_PORT=8765
# La app solo responde si se la abre como localhost, 127.0.0.1 o [::1] (y, con CL_HOST fuera de loopback, por la
# dirección IP de la máquina). Para abrirla además con un nombre (mi-equipo.local), listalo aquí: nombres
# separados por coma, sin http:// y sin puerto (se aceptan solo con el puerto de CL_PORT). Vacío = ninguno. Ver docs/seguridad.md
CL_ALLOWED_HOSTS=
# Ruta de la base SQLite
CL_DB_PATH=data/community_lens.db
# Zona horaria inicial sugerida al importar (editable por chat en la UI)
CL_DEFAULT_TZ=America/Costa_Rica

# --- JEV (TypeSafe) — OPCIONAL ---
# Sin estas variables la app funciona completa con el proveedor de reglas.
# Activar JEV envía texto de mensajes a api.typesafe.ai. Requiere además
# confirmación explícita en la UI por cada ejecución.
JEV_ENABLED=0
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Umbral sobre el valor "noul" (0–1) para asignar una categoría
JEV_THRESHOLD=0.8
# Mensajes previos enviados como contexto (0 = ninguno)
JEV_CONTEXT_MESSAGES=2
# Tope de mensajes por ejecución (control de costo y exposición)
JEV_MAX_MESSAGES=200

# --- PERIÓDICO — modelo de lenguaje (OPCIONAL) ---
# Sin ninguna key la app funciona completa en modo estadísticas; solo no se puede generar el periódico.
#
# Basta con UNA key: ese modelo hace todo (titulares, resúmenes, cronología y, si la pedís, su lectura
# de la conversación). Con varias keys:
#   - redacta el primero de esta lista que responda (Claude, OpenAI, Gemini), o el que elijás;
#   - cada modelo puede dar su propia lectura ("La visión de …").
#
# Qué sale de tu máquina al generar una edición:
#   - siempre: el texto público de las páginas enlazadas, al modelo que redacta;
#   - solo si pedís una lectura y lo confirmás: los mensajes del período con seudónimos, a cada modelo marcado.
#
# *_LABEL es opcional: el nombre con que firma el modelo en el periódico (p. ej. "Opus 5.5").
# Después de cambiar este archivo hay que reiniciar la app.
# Las keys se crean con una cuenta en la consola de cada proveedor y el uso se cobra aparte de las
# suscripciones de chat (Claude Pro, ChatGPT Plus, etc. no incluyen uso de la API).

# 1) Claude (Anthropic). El modelo es opcional; por defecto claude-opus-5-5.
#    Key:     https://platform.claude.com/settings/keys
#    Modelos: https://platform.claude.com/docs/en/models/overview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_LABEL=

# 2) OpenAI. El modelo es obligatorio: sin OPENAI_MODEL la key se ignora.
#    Key:     https://platform.openai.com/api-keys
#    Modelos: https://developers.openai.com/api/docs/models
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_LABEL=
# Otro proveedor: este mismo espacio sirve para cualquier servicio con API compatible con OpenAI
# (OpenRouter, Groq, Mistral, un modelo local con Ollama…). Poné aquí su dirección y arriba su key y su modelo.
# Es un solo espacio: OpenAI u otro, no los dos a la vez. Vacío = api.openai.com.
OPENAI_BASE_URL=

# 3) Gemini (Google). El modelo es obligatorio: sin GEMINI_MODEL la key se ignora.
#    Key:     https://aistudio.google.com/apikey
#    Modelos: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_LABEL=
